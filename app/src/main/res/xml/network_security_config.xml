<?xml version="1.0" encoding="utf-8"?>
<!--
  SECURITY: Global cleartext traffic is DENIED by default.
  Only explicit local-development domains (localhost, 10.0.2.2) are permitted
  to use HTTP. All production endpoints MUST use HTTPS.
  HIGH-1 fix: removed global cleartextTrafficPermitted="true".
-->
<network-security-config>

    <!-- Certificate pinning for the Baton backend API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.baton.com</domain>
        <pin-set expiration="2027-01-01">
            <!-- Primary pin — SHA-256 of the SubjectPublicKeyInfo -->
            <pin digest="SHA-256">7HIpactkIAq2Y49orFOOQKurWxmmSFZhBCoQYcRhJ3Y=</pin>
            <!-- Backup pin — rotate before expiry! -->
            <pin digest="SHA-256">fwza0LRMXouZHRC8Ei+4PyuldPDcf3UKgO/04cDM1oE=</pin>
        </pin-set>
    </domain-config>

    <!--
      LOCAL DEVELOPMENT ONLY: allow cleartext to the Android emulator host
      and localhost for testing against a locally-running Rust Gateway.
      This block has NO effect in production because production servers use HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Global default: deny all cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
