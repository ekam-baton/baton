<?xml version="1.0" encoding="utf-8"?>
<!--
  SECURITY: Global cleartext traffic is DENIED by default.
  The localhost/10.0.2.2/127.0.0.1 cleartext exception for local development
  lives ONLY in app/src/debug/res/xml/network_security_config.xml, which
  Gradle merges in for debug builds only. It is intentionally NOT here, so
  release builds get zero cleartext exceptions regardless of hostname.
-->
<network-security-config>

    <!-- Certificate pinning for the Baton backend API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.baton.com</domain>
        <pin-set expiration="2027-01-01">
            <!-- Primary pin — SHA-256 of the SubjectPublicKeyInfo -->
            <pin digest="SHA-256">7HIpactkIAq2Y49orFOOQKurWxmmSFZhBCoQYcRhJ3Y=</pin>
            <!-- Backup pin — rotate before expiry! -->
            <pin digest="SHA-256">fwza0LRMXouZHRC8Ei+4PyuldPDcf3UKgO/04cDM1oE=</pin>
        </pin-set>
    </domain-config>

    <!-- Global default: deny all cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
